@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix ahw:   <https://github.com/sejerpz/alabs-hmi-widgets#> .

<https://github.com/sejerpz/alabs-hmi-widgets/examples/hmi-widget-meter>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "HMI Widget Meter" ;
    doap:license "ISC" ;
    rdfs:comment "A gain with an output meter drawn on the display of the device: the plugin of the aLabs HMI widgets tutorial." ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;

    lv2:optionalFeature lv2:hardRTCapable, ahw:WidgetDraw ;
    lv2:extensionData ahw:WidgetNotification ;

    ahw:widget [
        a ahw:Widget ;
        lv2:symbol "meter" ;
        lv2:name "Output meter" ;
        ahw:minWidth 16 ;
        ahw:minHeight 8 ;
        ahw:naturalWidth 40 ;
        ahw:naturalHeight 37 ;
        ahw:suggestedPorts ( "gain" ) ;
    ] ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ], [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ], [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "gain" ;
        lv2:name "Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -20.0 ;
        lv2:maximum 20.0 ;
        units:unit units:db ;
    ] .
